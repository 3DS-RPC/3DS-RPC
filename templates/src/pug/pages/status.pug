extends ../layouts/dashboard.pug

block config
    - var bodyClass = 'sb-nav-fixed'
    - var pageTitle = 'Status'
    - var index = true
    - var sidenavStyle = 'sb-sidenav-dark'

block content
    .container-fluid.px-4
        include includes/page-header.pug

        style.
            .status-pill {
                padding: .35rem .75rem;
                border-radius: 1rem;
                font-weight: 600;
                font-size: .85rem;
            }
            .status-pill.up {
                background-color: #d1f7d4;
                color: #1b7d2f;
            }
            .status-pill.down {
                background-color: #fbd5d5;
                color: #a11c1c;
            }
            .status-pill.semi {
                background-color: #fdeccd;
                color: #925e08;
            }
            .queue-row {
                display: flex;
                align-items: center;
                gap: .75rem;
            }
            .queue-row .queue-label {
                min-width: 6.5rem;
                font-weight: 600;
                font-size: .85rem;
            }
            .queue-row .progress {
                flex: 1;
                height: 1.5rem;
            }
            .queue-row.is-idle .progress-bar {
                opacity: .45;
            }
            .queue-row.is-idle .progress-bar.queue-bar-idle {
                background-color: #ced4da;
                color: #495057;
                opacity: 1;
            }
            .queue-row .queue-ago {
                min-width: 9rem;
                text-align: right;
                font-size: .8rem;
                color: #6c757d;
            }
            .queue-meta {
                display: flex;
                flex-wrap: wrap;
                gap: .25rem 1rem;
                font-size: .85rem;
                color: #6c757d;
            }
            @media (max-width: 575.98px) {
                .queue-row {
                    flex-wrap: wrap;
                    gap: .4rem .6rem;
                }
                .queue-row .queue-label {
                    min-width: 0;
                    flex: 1 1 auto;
                }
                .queue-row .progress {
                    order: 3;
                    flex: 1 1 100%;
                }
                .queue-row .queue-ago {
                    min-width: 0;
                    margin-left: auto;
                }
            }

        .card.shadow-lg.border-0.rounded-lg.mb-3
            .card-header.d-flex.align-items-center.justify-content-between
                b Service Status
                span.status-pill.semi(id = 'global-status') Checking...
            .card-body
                p.mb-0.small.text-muted
                    | Live view of the backend queues for each network. Progress advances as
                    | each console is checked, so it reflects how quickly the network can be
                    | iterated right now.
                    span(id = 'status-cache-age')

        html {% for network in ('nintendo', 'pretendo') %}
        .card.shadow-lg.border-0.rounded-lg.mb-3
            .card-header.d-flex.align-items-center.justify-content-between
                b(id = '{{ network }}-name')
                    | {{ network.capitalize() }} Backend
                span.status-pill.semi(id = '{{ network }}-status') Checking...
            .card-body
                .queue-row.mb-2(id = '{{ network }}-slow-row')
                    span.queue-label Slow Queue
                    .progress
                        .progress-bar(id = '{{ network }}-slow-bar', role = 'progressbar', style = 'width: {{ data["service"]["networks"][network]["progress"]["slow"]["percent"] }}%;', aria-valuenow = '{{ data["service"]["networks"][network]["progress"]["slow"]["processed"] }}', aria-valuemin = '0', aria-valuemax = '{{ data["service"]["networks"][network]["progress"]["slow"]["total"] }}')
                            span(id = '{{ network }}-slow-progress')
                                | {{ data["service"]["networks"][network]["progress"]["slow"]["processed"] }} / {{ data["service"]["networks"][network]["progress"]["slow"]["total"] }}
                    span.queue-ago(id = '{{ network }}-slow-last') Checking...
                .queue-row.mb-2(id = '{{ network }}-fast-row')
                    span.queue-label Fast Queue
                    .progress
                        .progress-bar.progress-bar-striped(id = '{{ network }}-fast-bar', role = 'progressbar', style = 'width: {{ data["service"]["networks"][network]["progress"]["fast"]["percent"] }}%;', aria-valuenow = '{{ data["service"]["networks"][network]["progress"]["fast"]["processed"] }}', aria-valuemin = '0', aria-valuemax = '{{ data["service"]["networks"][network]["progress"]["fast"]["total"] }}')
                            span(id = '{{ network }}-fast-progress')
                                | {{ data["service"]["networks"][network]["progress"]["fast"]["processed"] }} / {{ data["service"]["networks"][network]["progress"]["fast"]["total"] }}
                    span.queue-ago(id = '{{ network }}-fast-last') Checking...
                .d-flex.flex-wrap.justify-content-between.queue-meta
                    span Last heartbeat: <span id='{{ network }}-last-heartbeat'>{{ data["service"]["networks"][network]["last_seen"] }}</span>
                    span Uptime: <span id='{{ network }}-uptime'>{{ data["service"]["networks"][network]["uptime_seconds"] }}</span>
                    span Tracked consoles: <span id='{{ network }}-tracked'>{{ data["service"]["networks"][network]["tracked"] }}</span>
                    span
                        span(id = '{{ network }}-loop-label') Last loop:
                        span(id = '{{ network }}-last-loop')
                            | {{ data["service"]["networks"][network]["last_loop_duration_seconds"] }}
        html {% endfor %}

        .card.shadow-lg.border-0.rounded-lg.mb-3
            .card-header
                b About the queues
            .card-body.queue-meta
                p.mb-2 The <b>Slow Queue</b> is for consoles that are not currently known to be online. They are checked oldest-first, with recently active users preferred and a starvation guard for dormant consoles.
                p.mb-0 The <b>Fast Queue</b> is for online consoles and newly created accounts. It is checked every couple of minutes.

        script.
            function relativeTime(epoch) {
                if (!epoch) return 'Never';
                var seconds = Math.floor(Date.now() / 1000 - epoch);
                if (seconds < 10) return 'Just now';
                if (seconds < 60) return seconds + ' seconds ago';
                if (seconds < 3600) return Math.floor(seconds / 60) + ' minutes ago';
                if (seconds < 86400) return Math.floor(seconds / 3600) + ' hours, ' + Math.floor((seconds % 3600) / 60) + ' minutes ago';
                var d = new Date(epoch * 1000);
                return d.toLocaleDateString();
            }

            function formatUptime(seconds) {
                if (!seconds || seconds <= 0) return 'Offline';
                var d = Math.floor(seconds / 86400);
                var h = Math.floor((seconds % 86400) / 3600);
                var m = Math.floor((seconds % 3600) / 60);
                if (d > 0) return d + 'd ' + h + 'h ' + m + 'm';
                if (h > 0) return h + 'h ' + m + 'm';
                return m + 'm';
            }

            function formatDuration(seconds) {
                if (seconds == null || seconds <= 0) return 'n/a';
                return seconds.toFixed(1) + 's';
            }

            function setPill(id, online, networkDown) {
                var pill = document.getElementById(id);
                if (!pill) return;
                if (online) {
                    pill.textContent = 'Up';
                    pill.className = 'status-pill up';
                } else {
                    pill.textContent = networkDown ? 'Network Down' : 'Offline';
                    pill.className = 'status-pill down';
                }
            }

            function renderQueue(key, mode, data) {
                var row = document.getElementById(key + '-' + mode + '-row');
                var bar = document.getElementById(key + '-' + mode + '-bar');
                var progress = document.getElementById(key + '-' + mode + '-progress');
                var last = document.getElementById(key + '-' + mode + '-last');
                var active = !!data.active;
                var empty = !data.total;
                if (row) row.classList.toggle('is-idle', !active || empty);
                if (bar) {
                    bar.classList.toggle('queue-bar-idle', empty);
                    bar.style.width = (empty ? 100 : data.percent) + '%';
                }
                if (progress) {
                    if (empty) {
                        progress.textContent = 'Idle';
                    } else {
                        var suffix = '';
                        if (data.skipped) suffix += ' · ' + data.skipped + ' skipped';
                        if (data.failed) suffix += ' · ' + data.failed + ' failed';
                        progress.textContent = data.processed + ' / ' + data.total + suffix + (active ? '' : ' (idle)');
                    }
                }
                if (last) last.textContent = empty ? 'Idle' : relativeTime(data.last_update);
            }

            function renderStatus(data) {
                var cacheAge = document.getElementById('status-cache-age');
                if (cacheAge) {
                    if (data.stale) {
                        cacheAge.textContent = ' Status data is stale (' + Math.round(data.cache_age_seconds || 0) + 's old).';
                    } else if (typeof data.cache_age_seconds === 'number') {
                        cacheAge.textContent = ' Updated ' + data.cache_age_seconds + 's ago.';
                    }
                }

                var networks = data.networks || {};
                var onlineCount = 0;
                Object.keys(networks).forEach(function (key) {
                    var net = networks[key];
                    setPill(key + '-status', net.online, net.network_status === 'down');
                    if (net.online) onlineCount++;

                    var progress = net.progress || {};
                    renderQueue(key, 'slow', progress.slow || { processed: 0, total: 0, percent: 0, last_update: 0 });
                    renderQueue(key, 'fast', progress.fast || { processed: 0, total: 0, percent: 0, last_update: 0 });

                    var lastHeartbeat = document.getElementById(key + '-last-heartbeat');
                    if (lastHeartbeat) lastHeartbeat.textContent = relativeTime(net.last_seen);
                    var uptime = document.getElementById(key + '-uptime');
                    if (uptime) uptime.textContent = formatUptime(net.uptime_seconds);
                    var tracked = document.getElementById(key + '-tracked');
                    if (tracked) tracked.textContent = net.tracked;
                    var loopLabel = document.getElementById(key + '-loop-label');
                    var lastLoop = document.getElementById(key + '-last-loop');
                    if (loopLabel && lastLoop) {
                        if (net.loop_mode) {
                            loopLabel.textContent = 'Current cycle:';
                            lastLoop.textContent = formatDuration(net.current_loop_elapsed_seconds);
                        } else {
                            loopLabel.textContent = 'Last loop:';
                            lastLoop.textContent = formatDuration(net.last_loop_duration_seconds);
                        }
                    }
                });

                var global = document.getElementById('global-status');
                if (global) {
                    if (onlineCount === Object.keys(networks).length) {
                        global.textContent = data.status || 'Operational';
                        global.className = 'status-pill up';
                    } else if (onlineCount > 0) {
                        global.textContent = 'Semi-Operational';
                        global.className = 'status-pill semi';
                    } else {
                        global.textContent = 'Offline';
                        global.className = 'status-pill down';
                    }
                }
            }

            function loadStatus() {
                var xmlHttp = new XMLHttpRequest();
                xmlHttp.open('GET', '/api/status/', true);
                xmlHttp.onreadystatechange = function () {
                    if (xmlHttp.readyState === 4 && xmlHttp.status === 200) {
                        try {
                            renderStatus(JSON.parse(xmlHttp.responseText));
                        } catch (e) {
                            console.error('Failed to parse status response', e);
                        }
                    }
                };
                xmlHttp.send();
            }

            (function () {
                renderStatus({{ data['service'] | tojson }});
                loadStatus();
                setInterval(loadStatus, 5000);
            })();