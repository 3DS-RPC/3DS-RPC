extends ../layouts/dashboard.pug

block config
    - var bodyClass = 'sb-nav-fixed'
    - var pageTitle = "{{ data['title'] }}"
    - var sidenavStyle = 'sb-sidenav-dark'

block content
    .container-fluid.px-4
        include includes/page-header.pug

        style.
            .user-tile {
                text-decoration: none;
                color: inherit;
            }
            .user-tile .card {
                height: 100%;
            }
            .user-tile-media {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                min-height: 120px;
                padding: .75rem;
            }
            .user-tile-game {
                height: 48px;
                align-self: flex-end;
            }
            .user-tile-mii {
                height: 100px;
            }
            .user-tile-name {
                padding: .6rem .5rem;
                text-align: center;
                background: #fff;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .row.gy-3
            html {% for i in data['users'] %}
            a.col-sm-3.col-6.user-tile(href = '/user/{{ i["friendCode"] }}?network={{ i["network"] }}')
                .card.app-card.app-lift
                    .user-tile-media.mii-bg(class = "mii-bg-{{ i['network'] }}")
                        html {% if i.get('game') %}
                        img.user-tile-game(src = '{{ i["game"]["icon_url"] }}')
                        html {% else %}
                        span.user-tile-game
                        html {% endif %}
                        img.user-tile-mii(src = '{{ i["mii"]["face"] }}')
                    .user-tile-name {{ i['username'] }}
            html {% endfor %}
