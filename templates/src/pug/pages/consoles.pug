extends ../layouts/dashboard.pug

block config
    - var bodyClass = 'sb-nav-fixed'
    - var pageTitle = "Consoles"
    - var sidenavStyle = 'sb-sidenav-dark'

block content
    .container-fluid.px-4
        include includes/page-header.pug

        style.
            .card.subsequentCard {
                background-color: #ffb759;
            }
            .card.mainCard {
                background-color: #FC8C2C;
            }
            .icon img {
                width: 50px;
                filter: invert(51%) sepia(12%) saturate(0%) hue-rotate(181deg) brightness(89%) contrast(87%);
            }
            .icon.active img {
                filter: invert(49%) sepia(44%) saturate(749%) hue-rotate(84deg) brightness(101%) contrast(79%);
            }
            .console-grid {
                display: grid;
                grid-template-columns: .8fr 2.2fr .9fr .9fr 1.2fr;
                align-items: center;
                gap: .5rem;
                width: 100%;
            }
            .console-grid .last-updated {
                font-size: .8rem;
                color: #5b534c;
            }
            .console-grid > div {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                text-align: center;
                min-width: 0;
            }
            .console-cell-label {
                display: none;
                font-size: .65rem;
                font-weight: 600;
                letter-spacing: .05em;
                text-transform: uppercase;
                color: #5b534c;
            }
            .console-title {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: center;
                gap: .35rem;
                text-align: center;
                overflow-wrap: anywhere;
            }
            .console-name a {
                overflow-wrap: anywhere;
            }
            .health-marker {
                display: inline-block;
                width: 10px;
                height: 10px;
                margin-left: 8px;
                border-radius: 50%;
                vertical-align: middle;
            }
            .health-marker.health-degraded {
                background-color: #ffb759;
            }
            .health-marker.health-error {
                background-color: #e74c3c;
            }
            .health-marker.health-ok {
                background-color: #28a745;
            }
            @media (max-width: 767.98px) {
                .console-list-header {
                    display: none;
                }
                .console-grid-body {
                    grid-template-columns: repeat(3, minmax(0, 1fr));
                    grid-template-areas:
                        'name name name'
                        'enable refresh delete'
                        'updated updated updated';
                    row-gap: .9rem;
                }
                .console-grid-body > div {
                    gap: .15rem;
                    font-size: .9rem;
                }
                .console-cell-label {
                    display: block;
                }
                .console-name {
                    grid-area: name;
                }
                .console-enable {
                    grid-area: enable;
                }
                .console-refresh {
                    grid-area: refresh;
                }
                .console-delete {
                    grid-area: delete;
                }
                .console-updated {
                    grid-area: updated;
                }
            }

        script.
            function clicked(active, fc, network) {
                active = active == 'False';
                var xmlHttp = new XMLHttpRequest();
                xmlHttp.open( "POST", "/api/toggle/" + fc, false );
                xmlHttp.send( [token, +active, network] );
                if (xmlHttp.responseText == 'success!') {
                    location.reload();
                } else {
                    redirectOnFailure(xmlHttp.responseText);
                }
            }
            function deleteCode(fc, network) {
                var xmlHttp = new XMLHttpRequest();
                xmlHttp.open( "POST", "/api/delete/" + fc, false );
                xmlHttp.send([token, network]);
                if (xmlHttp.responseText == 'success!') {
                    location.reload();
                } else {
                    redirectOnFailure(xmlHttp.responseText);
                }
            }
            function refreshCode(fc, network) {
                var xmlHttp = new XMLHttpRequest();
                xmlHttp.open( "POST", "/api/refresh/" + fc, false );
                xmlHttp.send([token, network]);
                if (xmlHttp.responseText == 'success!') {
                    location.reload();
                } else if (/session is invalid/i.test(xmlHttp.responseText)) {
                    // A dead session needs a full recovery, not an alert.
                    redirectOnFailure(xmlHttp.responseText);
                } else {
                    alert(xmlHttp.responseText.replace(/^failure!\s*/, ''));
                }
            }

        .card.shadow-lg.border-0.rounded-lg.mainCard(style = 'margin-bottom: 25px;')
            .card-header.console-list-header
                .console-grid.px-3.py-1
                    div
                        b Enable
                    div
                        b Consoles
                    div
                        b Refresh
                    div
                        b Delete
                    div
                        b Last Updated
            .card-body
                html {% for console in data['consoles'] %}
                .card.g-0.shadow-lg.border-0.rounded-lg.subsequentCard(style = 'margin-bottom: 25px;')
                    .card-header
                        .console-title
                            b Console {{ loop.index0 + 1 }} ({{ console['fc'] }} on {{ console['network'].capitalize() }})
                            span.health-marker(class = "health-{{ console['health'] }}", title = '{{ console["health_reason_label"] }}')
                    .card-body.m-0.p-0
                        .console-grid.console-grid-body.p-3
                            .console-enable
                                span.console-cell-label Enable
                                a(class = "icon {{ 'active' if console['active'] }}" href = "javascript:clicked('{{ console['active'] }}', {{ console['fc'].replace('-', '') }}, '{{ console['network'] }}')")
                                    html {% if not console['active'] %}
                                    img(src = '{{ url_for("static",filename="assets/img/star.svg") }}')
                                    html {% else %}
                                    img(src = '{{ url_for("static",filename="assets/img/star-fill.svg") }}')
                                    html {% endif %}
                            .console-name
                                span.console-cell-label Console
                                a(href = "/user/{{ console['fc'].replace('-', '') }}?network={{ console['network'] }}" style = 'text-decoration: none;')
                                    b {{ console['username'] }}
                            .console-refresh
                                span.console-cell-label Refresh
                                html {% if console['tracked'] %}
                                a(href = "javascript:refreshCode({{ console['fc'].replace('-', '') }}, '{{ console['network']}}');" style = 'text-decoration: none;')
                                    b Refresh
                                html {% else %}
                                span.text-muted(style = 'cursor: not-allowed;')
                                    b Refresh
                                html {% endif %}
                            .console-delete
                                span.console-cell-label Delete
                                a(href = "javascript:deleteCode({{ console['fc'].replace('-', '') }}, '{{ console['network']}}');" style = 'text-decoration: none;')
                                    b Delete
                            .console-updated.last-updated
                                span.console-cell-label Last Updated
                                html {% if console['last_updated'] %}
                                span(title = '{{ console["last_updated"] }}') {{ console['last_updated_text'] }}
                                html {% else %}
                                span Never
                                html {% endif %}
                html {% endfor %}
        .card.text-center.shadow-lg.border-0.rounded-lg
            .card-header
                b Add a new console?
            .card-body.d-flex.align-items-center.justify-content-center
                .col-lg-10
                    a.btn.btn-primary.btn-block.input-block-level.form-control(href = '/register')
                      | Register Friend Code
