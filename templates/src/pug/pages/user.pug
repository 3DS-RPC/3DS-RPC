extends ../layouts/dashboard.pug

block config
    - var bodyClass = 'sb-nav-fixed'
    - var pageTitle = "{{ data['User']['username'] }}"
    - var fc = "{{ data['User']['friendCode'] }}"
    - var sidenavStyle = 'sb-sidenav-dark'
    - var description = "{{ (data['User']['message'] + '\n') if data['User']['message'] }}{{ 'Favorite game: ' + data['User']['favoriteGame']['name'] if data['User']['favoriteGame'] }}"
    - var network = "{{ data['User']['network']}}"

block content
    
    .container-fluid.px-4
        include includes/page-header.pug
        
        html {% for game in (data['User']['Presence']['game'], data['User']['favoriteGame']) %}
        html {% if game %}
        .modal.fade(tabindex = '-1', aria-labelledby = 'modelLabel', aria-hidden = 'true')
            .modal-dialog
                .modal-content
                    .modal-header
                        h5.modal-title#modalLabel
                            b {{ game['name'] }}
                            | by
                            b {{ game['publisher']['name'] }}
                        button.btn-close(type = 'button' data-bs-dismiss = 'modal' aria-label = 'Close')
                    .modal-body
                        div
                            img(src = "{{ game['banner_url'] }}", style = "height: 100%; width: 100%;")
                        div.d-flex.justify-content-between
                            div Genre: {{ game['display_genre'] }}
                            div Rating:
                                b {{ game['star_rating_info']['score'] }}/5
                                | Stars
                        div.d-flex.justify-content-between
                            div Price: {{ game['price_on_retail'] }}
                            div Released:
                                b {{ game['release_date_on_eshop'] }}
                    .modal-footer
                        html {% if game['name'] != 'Home Screen' %}
                        button.btn.btn-secondary(type = 'button' onclick = "window.open(`https://www.google.com/search?q={{ '+'.join((game['name'] + ' ' + game['publisher']['name']).split(' ')) }}`, `_blank`);") Search Online
                        html {% endif %}
                        button.btn.btn-primary(type = 'button' data-bs-dismiss = 'modal') Close
        html {% else %}
        .modal.fade(tabindex = '-1', aria-labelledby = 'modelLabel', aria-hidden = 'true')
            .modal-dialog
                .modal-content
                    .modal-header
                        h5.modal-title#modalLabel
                            b None
                    .modal-footer
                        button.btn.btn-primary(type = 'button' data-bs-dismiss = 'modal') Close
        html {% endif %}
        html {% endfor %}

        script.
            let f = document.getElementsByClassName('modal');
            for (let i = 0; i < f.length; i++)
            {
                f[i].id = 'ID' + i.toString();
            }

        style.
            .profile-mii {
                width: 100%;
                max-width: 220px;
                border-radius: .75rem;
            }
            .game-row img {
                height: 64px;
            }
            .fav-game img {
                height: 112px;
            }

        .row.mb-4
            .col-sm-4.col-md-3.d-flex.align-items-end.justify-content-center
                img.profile-mii.mii-bg(src = "{{ data['User']['mii']['face'] }}")
            .col-md-9
                .card.app-card.h-100
                    html {% if data['User']['Presence']['game'] %}
                    .card-header Currently Playing
                    html {% endif %}
                    a.card-body.d-flex.align-items-center.text-black.game-row(style = 'text-decoration: none;', data-bs-toggle="modal", href = '#ID0')
                        html {% if data['User']['Presence']['game'] %}
                        img(src = "{{ data['User']['Presence']['game']['icon_url'] }}")
                        span(style = 'padding-left: 1rem;') {{ data['User']['Presence']['game']['name'] }}
                        html {% else %}
                        .text-muted.text-center.w-100 Offline
                        html {% endif %}
                    html {% if data['User']['Presence']['gameDescription'] %}
                    .card-footer.text-muted.small
                        html.
                          {% for i in data['User']['Presence']['gameDescription'].split('\n') %}
                          {{ i }}
                          <br>
                          {% endfor %}
                    html {% endif %}
        .row.mb-4
            html {% if data['User']['message'] %}
            .col-sm-6.col-xl-4.mb-3.mb-xl-0
                .card.app-card.h-100
                    .card-header Status
                    .card-body {{ data['User']['message'] }}
            html {% endif %}
            .col-sm-6.col-xl-4.mb-3.mb-xl-0
                .card.app-card.h-100
                    .card-header Member Since
                    .card-body {{ data['User']['accountCreation'] }}
            .col-sm-6.col-xl-4
                .card.app-card.h-100
                    .card-header Last Online
                    .card-body {{ data['User']['lastOnline'] }}
        .row
            .col-12
                .card.app-card
                    .card-header Favorite Game
                    a.card-body.d-flex.align-items-center.text-black.game-row.fav-game(style = 'text-decoration: none;', data-bs-toggle="modal", href = '#ID1')
                      html {% if data['User']['favoriteGame'] %}
                      img(src = "{{ data['User']['favoriteGame']['icon_url'] }}")
                      span(style = 'padding-left: 1rem;') {{ data['User']['favoriteGame']['name'] }}
                      html {% else %}
                      .text-muted.text-center.w-100 None
                      html {% endif %}
