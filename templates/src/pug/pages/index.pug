extends ../layouts/dashboard.pug

block config
    - var bodyClass = 'sb-nav-fixed'
    - var pageTitle = 'Home';
    - var index = true;
    - var sidenavStyle = 'sb-sidenav-dark'

prepend css
    //- Load Simple DataTables Stylesheet
    link(href='https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css', rel='stylesheet')

mixin userList(listKey, gameCondition)
    .card-body.user-list
        html {% for i in data['!{listKey}'] %}
        a.card.app-card.app-lift.user-card(href = "/user/{{ i['friendCode'] }}?network={{ i['network'] }}")
            .card-body
                .d-flex.flex-row.flex-wrap.align-items-center.justify-content-center.gap-3
                    .d-flex.flex-column.align-items-center.user-col
                        span.app-label User
                        img.user-mii.mii-bg(src = "{{ i['mii']['face'] }}", class = "mii-bg-{{ i['network'] }}")
                        span.user-name {{ i['username'] }}
                    html {% if !{gameCondition} %}
                    .d-flex.flex-column.align-items-center.text-center.text-break.user-col
                        span.app-label Now playing
                        img.user-banner(src = "{{ i['game']['banner_url'] }}")
                        span.user-game-name {{ i['game']['name'] }}
                    html {% endif %}
            .card-footer.small.text-center.user-footer
                | Click here to view this user's profile!
        html {% endfor %}

block content
    .container-fluid.px-4
        include includes/page-header.pug

        style.
            .user-list {
                display: flex;
                flex-direction: column;
                gap: 1rem;
            }
            .user-card .card-body {
                padding: 1.25rem;
            }
            .user-mii {
                height: 96px;
                border-radius: .5rem;
            }
            .user-banner {
                height: 96px;
                border-radius: .5rem;
            }
            .user-name {
                font-weight: 600;
                margin-top: .4rem;
            }
            .user-game-name {
                width: 200px;
                margin: .4rem 0 0;
            }
            .user-footer {
                border-top: 1px solid rgba(0, 0, 0, .06);
                color: #8a8a8a;
                transition: color .15s ease;
            }
            .user-card:hover .user-footer {
                color: #FC8C2C;
            }

        .row
            .col-xl-4
                .card.mb-4
                    .card-header
                        i.fas.fa-chart-area.me-1
                        a(href = '/active' style = 'text-decoration: none;')
                            b {{ data['num'] }}
                            | Actively Playing Users...
                    +userList('active', "not i['game']['name'] in ('Home Screen', 'Unknown 3DS App')")
            .col-xl-4
                .card.mb-4
                    .card-header
                        i.fas.fa-chart-bar.me-1
                        a(href = '/roster' style = 'text-decoration: none;')
                            | Recently Joined Users...
                    +userList('new', "i['game']")
